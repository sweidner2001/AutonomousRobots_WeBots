    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Webots Extern",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "WEBOTS_HOME": "C:\\Program Files\\Webots",
                "PYTHONPATH": "C:\\Program Files\\Webots\\lib\\controller\\python"
            }
        }
    ]
}
